[node name="HelpContent" type="RichTextLabel" parent="HelpModal/VBox"]
custom_minimum_size = Vector2(0, 260)
layout_mode = 2
bbcode_enabled = true
text = "[b]CONTROLS:[/b]
• [color=#5eead4]W / UP ARROW[/color] : Accelerate
• [color=#5eead4]S / DOWN ARROW[/color] : Brake & Reverse
• [color=#5eead4]A / D or LEFT / RIGHT[/color] : Steer & Drift
• [color=#38bdf8]SHIFT / SPACEBAR[/color] : Nitro Boost (Regenerates over time)
• [color=#38bdf8]M KEY / CLICK RADAR[/color] : Expand / Minimize Tactical Radar
• [color=#fbbf24]ESC[/color] : Pause

[b]SURVIVAL MECHANICS:[/b]
• [color=#f59e0b]CLOSE CALLS[/color]: Steer narrowly past pursuit vehicles to initiate Time Dilation and build your Escape Chain multiplier up to x10!
• [color=#a855f7]COP BLASTS[/color]: Bait police into colliding with each other to trigger massive explosions (+500 pts)!
• [color=#34d399]EXTRACTION[/color]: Drive to the illuminated Sky Laser Beacon to clear the sector!"

